# GuardVarX Environment Configuration
# Copy this file to .env and populate the actual secrets for local development.
# NEVER commit the real .env file into version control!

# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=guardvarx_user
DB_PASSWORD=guardvarx_secure_pass
DB_NAME=guardvarx_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h

# Firebase Authentication & Admin
FIREBASE_PROJECT_ID=guardvarx-safety
# Path to service account JSON or base64 encoded credential string
FIREBASE_CREDENTIALS_FILE=
# Set to true only in local test/mock environments to allow mock tokens for automated testing
ALLOW_MOCK_AUTH=false

# Push Notifications (FCM)
FCM_ENABLED=true

# Security & Encryption
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Data Retention Policy (hours)
LOCATION_RETENTION_HOURS=24
RESOLVED_INCIDENT_COORDINATE_RETENTION_HOURS=24
